# 环境变量示例文件
# 用法：复制为 .env.local 后按实际环境填写；.env.local 已被 .gitignore 忽略，请勿提交真实密钥

# ===== 站点配置 =====
# 站点根域名（不含末尾斜杠），用于 RSS / Sitemap 生成；未配置时回退默认域名
NEXT_PUBLIC_SITE_URL=https://www.gouxinjie.com

# 百度统计站点 ID（hm.js 后面的字符串）
NEXT_PUBLIC_BAIDU_TONGJI_ID=

# GitHub 个人访问令牌，用于服务端调用 GitHub API 提升限流额度
GITHUB_TOKEN=

# ===== OSS 图片加速配置 =====
# 上传脚本（pnpm uploadOss）与图片地址转换（utils/oss.ts）均依赖以下配置
# OSS 地域，例如 oss-cn-hangzhou、oss-cn-beijing
OSS_REGION=
# OSS 存储空间名称
OSS_BUCKET=mylab-images
# RAM 子账号访问密钥（建议仅授予该 bucket 的读写权限）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 上传到 OSS 的对象键前缀，与本地 public/images 目录结构保持一致
OSS_PREFIX=images
# OSS 公网访问基础地址（不含末尾斜杠）；未配置时图片自动回退为本地 /images 路径
# 普通外网域名：https://<bucket>.oss-<region>.aliyuncs.com
# 传输加速域名：https://<bucket>.oss-accelerate.aliyuncs.com（需先开启传输加速）
NEXT_PUBLIC_OSS_BASE_URL=
